{
  "name": "ai-pictionary",
  "version": "1.0.0",
  "private": true,
  "description": "AI Pictionary - a party game using Stable Diffusion (Forge) image generation",
  "workspaces": [
    "server",
    "web",
    "worker",
    "bot"
  ],
  "scripts": {
    "build": "npm run build --workspace web && npm run build --workspace server",
    "build:server": "npm run build --workspace server",
    "build:web": "npm run build --workspace web",
    "build:worker": "npm run build --workspace worker",
    "build:bot": "npm run build --workspace bot",
    "start": "node server/dist/index.js",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "dev:worker": "npm run dev --workspace worker",
    "dev": "concurrently -n server,web \"npm:dev:server\" \"npm:dev:web\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
