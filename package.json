{
  "name": "ai-pictionary-runware",
  "version": "1.0.0",
  "private": true,
  "description": "AI Pictionary (test1) - image generation via the Runware API instead of a local Forge worker",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspace web && npm run build --workspace server",
    "build:server": "npm run build --workspace server",
    "build:web": "npm run build --workspace web",
    "start": "node server/dist/index.js",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "dev": "concurrently -n server,web \"npm:dev:server\" \"npm:dev:web\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
