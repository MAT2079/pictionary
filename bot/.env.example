# Discord control bot configuration (spec §20). Copy to .env and fill in.

# Bot token from the Discord Developer Portal (Bot tab).
DISCORD_TOKEN=your-bot-token

# The single guild (server) ID the commands are registered to.
GUILD_ID=000000000000000000

# Only this Discord user ID may run the commands.
ALLOWED_USER_ID=000000000000000000

# Directory containing docker-compose.yml (the forge/ folder of this repo).
COMPOSE_DIR=C:\\path\\to\\ai-pictionary\\forge

# Cloud server base URL the worker polls (used for /status health probe and as
# the default for /run if render_url is omitted). e.g. https://ai-pictionary.onrender.com
RENDER_URL=

# Optional: forwarded into the compose .env so the worker authenticates.
WORKER_SECRET=

# Optional: local Forge URL for the /status probe (default http://localhost:7860).
FORGE_URL=http://localhost:7860
